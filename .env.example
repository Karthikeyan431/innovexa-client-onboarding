# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# --- Public (bundled into the browser; safe to expose) -----------------------
# Supabase project URL and anon/publishable key (Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only (used by /api functions; NEVER prefix with VITE_) -----------
# Service role / secret key. Bypasses RLS — keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Random string used to hash client IPs for rate limiting (e.g. `openssl rand -hex 32`).
IP_HASH_SALT=change-me-to-a-long-random-string

# Transactional email via Resend (https://resend.com). If unset, submissions
# still work and emails are logged as "skipped".
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Innovexa Digital <onboarding@innovexadigital.in>"
EMAIL_REPLY_TO=contact@innovexadigital.in
# Comma-separated list of team addresses that receive new-submission alerts.
ADMIN_NOTIFICATION_EMAILS=contact@innovexadigital.in

# Public URL of this app (used for dashboard links in emails).
APP_BASE_URL=https://innovexa-client-onboarding.vercel.app
# Optional: max submissions per client IP per hour (default 10).
SUBMISSIONS_PER_IP_PER_HOUR=10
